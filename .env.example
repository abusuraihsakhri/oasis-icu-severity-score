# OASIS ICU Severity Score - Environment Configuration
# Copy this file to .env and replace with your secure values

# Required: HMAC-SHA256 audit trail secret key (minimum 16 characters)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=change-me-to-a-secure-random-key

# Optional: LLM provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
